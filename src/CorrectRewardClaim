#![no_std]

use soroban_sdk::{
    contract,
    contractimpl,
    contracttype,
    symbol_short,
    Address,
    Env,
    Symbol,
};

// ============================================================
// CONTRACT
// ============================================================

#[contract]
pub struct RewardContract;

// ============================================================
// STORAGE KEYS
// ============================================================

#[contracttype]
#[derive(Clone)]
pub enum DataKey {
    Admin,
    Reward(Address),
    Claimed(Address),
    ClaimCount,
    TotalRewards,
    ClaimRecord(u32),
}

// ============================================================
// REWARD RECORD
// ============================================================

#[contracttype]
#[derive(Clone)]
pub struct RewardRecord {
    pub user: Address,
    pub amount: i128,
    pub claimed: bool,
}

// ============================================================
// CLAIM RECORD
// ============================================================

#[contracttype]
#[derive(Clone)]
pub struct ClaimRecord {
    pub id: u32,
    pub user: Address,
    pub amount: i128,
    pub timestamp: u64,
}

// ============================================================
// CONTRACT IMPLEMENTATION
// ============================================================

#[contractimpl]
impl RewardContract {

    // --------------------------------------------------------
    // INITIALIZE
    // --------------------------------------------------------

    pub fn initialize(
        env: Env,
        admin: Address,
    ) {
        admin.require_auth();

        if env.storage()
            .instance()
            .has(&DataKey::Admin)
        {
            panic!("Contract already initialized");
        }

        env.storage()
            .instance()
            .set(
                &DataKey::Admin,
                &admin,
            );

        env.storage()
            .instance()
            .set(
                &DataKey::ClaimCount,
                &0u32,
            );

        env.storage()
            .instance()
            .set(
                &DataKey::TotalRewards,
                &0i128,
            );

        env.events().publish(
            (symbol_short!("init"),),
            admin,
        );
    }

    // --------------------------------------------------------
    // CREATE REWARD
    // --------------------------------------------------------

    pub fn create_reward(
        env: Env,
        user: Address,
        amount: i128,
    ) {
        let admin = Self::require_admin(&env);

        if amount <= 0 {
            panic!("Reward amount must be positive");
        }

        let existing: i128 = env
            .storage()
            .persistent()
            .get(&DataKey::Reward(user.clone()))
            .unwrap_or(0);

        let new_reward = existing
            .checked_add(amount)
            .unwrap_or_else(|| {
                panic!("Reward amount overflow")
            });

        env.storage()
            .persistent()
            .set(
                &DataKey::Reward(user.clone()),
                &new_reward,
            );

        let total_rewards: i128 = env
            .storage()
            .instance()
            .get(&DataKey::TotalRewards)
            .unwrap_or(0);

        let new_total = total_rewards
            .checked_add(amount)
            .unwrap_or_else(|| {
                panic!("Total reward overflow")
            });

        env.storage()
            .instance()
            .set(
                &DataKey::TotalRewards,
                &new_total,
            );

        // ----------------------------------------------------
        // REWARD CREATED EVENT
        // ----------------------------------------------------

        env.events().publish(
            (symbol_short!("reward"), symbol_short!("create")),
            (
                admin,
                user,
                amount,
            ),
        );
    }

    // --------------------------------------------------------
    // CLAIM REWARD
    // --------------------------------------------------------

    pub fn claim_reward(
        env: Env,
        user: Address,
    ) -> i128 {

        // ----------------------------------------------------
        // AUTHORIZATION
        // ----------------------------------------------------

        user.require_auth();

        // ----------------------------------------------------
        // CHECK EXISTING CLAIM
        // ----------------------------------------------------

        let already_claimed: bool = env
            .storage()
            .persistent()
            .get(&DataKey::Claimed(user.clone()))
            .unwrap_or(false);

        if already_claimed {
            panic!("Reward has already been claimed");
        }

        // ----------------------------------------------------
        // LOAD REWARD
        // ----------------------------------------------------

        let reward: i128 = env
            .storage()
            .persistent()
            .get(&DataKey::Reward(user.clone()))
            .unwrap_or(0);

        if reward <= 0 {
            panic!("No reward available");
        }

        // ----------------------------------------------------
        // TRANSACTION HOOK
        // ----------------------------------------------------

        /*
         * The claim hook must execute before the claim is
         * considered complete.
         *
         * This is where integrations can perform accounting,
         * token transfers, callbacks, or additional validation.
         */

        Self::before_claim(
            &env,
            &user,
            reward,
        );

        // ----------------------------------------------------
        // MARK AS CLAIMED
        // ----------------------------------------------------

        env.storage()
            .persistent()
            .set(
                &DataKey::Claimed(user.clone()),
                &true,
            );

        // ----------------------------------------------------
        // CLEAR AVAILABLE REWARD
        // ----------------------------------------------------

        env.storage()
            .persistent()
            .set(
                &DataKey::Reward(user.clone()),
                &0i128,
            );

        // ----------------------------------------------------
        // UPDATE TOTAL REWARDS
        // ----------------------------------------------------

        let total_rewards: i128 = env
            .storage()
            .instance()
            .get(&DataKey::TotalRewards)
            .unwrap_or(0);

        let remaining = total_rewards
            .checked_sub(reward)
            .unwrap_or_else(|| {
                panic!("Reward accounting underflow")
            });

        env.storage()
            .instance()
            .set(
                &DataKey::TotalRewards,
                &remaining,
            );

        // ----------------------------------------------------
        // CREATE CLAIM RECORD
        // ----------------------------------------------------

        let claim_count: u32 = env
            .storage()
            .instance()
            .get(&DataKey::ClaimCount)
            .unwrap_or(0);

        let claim_id = claim_count
            .checked_add(1)
            .unwrap_or_else(|| {
                panic!("Claim count overflow")
            });

        let timestamp =
            env.ledger().timestamp();

        let record = ClaimRecord {
            id: claim_id,
            user: user.clone(),
            amount: reward,
            timestamp,
        };

        env.storage()
            .persistent()
            .set(
                &DataKey::ClaimRecord(claim_id),
                &record,
            );

        env.storage()
            .instance()
            .set(
                &DataKey::ClaimCount,
                &claim_id,
            );

        // ----------------------------------------------------
        // AFTER CLAIM HOOK
        // ----------------------------------------------------

        Self::after_claim(
            &env,
            &user,
            reward,
            claim_id,
        );

        // ----------------------------------------------------
        // CLAIM EVENT
        // ----------------------------------------------------

        env.events().publish(
            (
                symbol_short!("reward"),
                symbol_short!("claim"),
            ),
            (
                user.clone(),
                reward,
                claim_id,
                timestamp,
            ),
        );

        reward
    }

    // --------------------------------------------------------
    // BEFORE CLAIM HOOK
    // --------------------------------------------------------

    fn before_claim(
        env: &Env,
        user: &Address,
        amount: i128,
    ) {

        /*
         * This hook intentionally does not modify the user's
         * claim state.
         *
         * Validation occurs before state mutation.
         *
         * If this function panics, the entire transaction
         * fails and the claim remains unclaimed.
         */

        if amount <= 0 {
            panic!("Invalid reward amount");
        }

        env.events().publish(
            (symbol_short!("hook"), symbol_short!("before")),
            (
                user.clone(),
                amount,
            ),
        );
    }

    // --------------------------------------------------------
    // AFTER CLAIM HOOK
    // --------------------------------------------------------

    fn after_claim(
        env: &Env,
        user: &Address,
        amount: i128,
        claim_id: u32,
    ) {

        /*
         * This hook runs after the reward state has been
         * successfully updated.
         */

        env.events().publish(
            (symbol_short!("hook"), symbol_short!("after")),
            (
                user.clone(),
                amount,
                claim_id,
            ),
        );
    }

    // --------------------------------------------------------
    // CHECK CLAIM STATUS
    // --------------------------------------------------------

    pub fn has_claimed(
        env: Env,
        user: Address,
    ) -> bool {

        env.storage()
            .persistent()
            .get(&DataKey::Claimed(user))
            .unwrap_or(false)
    }

    // --------------------------------------------------------
    // GET AVAILABLE REWARD
    // --------------------------------------------------------

    pub fn get_reward(
        env: Env,
        user: Address,
    ) -> i128 {

        env.storage()
            .persistent()
            .get(&DataKey::Reward(user))
            .unwrap_or(0)
    }

    // --------------------------------------------------------
    // GET CLAIM RECORD
    // --------------------------------------------------------

    pub fn get_claim(
        env: Env,
        claim_id: u32,
    ) -> ClaimRecord {

        env.storage()
            .persistent()
            .get(&DataKey::ClaimRecord(claim_id))
            .unwrap_or_else(|| {
                panic!("Claim record not found")
            })
    }

    // --------------------------------------------------------
    // GET CLAIM COUNT
    // --------------------------------------------------------

    pub fn get_claim_count(
        env: Env,
    ) -> u32 {

        env.storage()
            .instance()
            .get(&DataKey::ClaimCount)
            .unwrap_or(0)
    }

    // --------------------------------------------------------
    // GET TOTAL UNCLAIMED REWARDS
    // --------------------------------------------------------

    pub fn get_total_rewards(
        env: Env,
    ) -> i128 {

        env.storage()
            .instance()
            .get(&DataKey::TotalRewards)
            .unwrap_or(0)
    }

    // --------------------------------------------------------
    // GET ADMIN
    // --------------------------------------------------------

    pub fn get_admin(
        env: Env,
    ) -> Address {

        env.storage()
            .instance()
            .get(&DataKey::Admin)
            .unwrap_or_else(|| {
                panic!("Contract not initialized")
            })
    }

    // --------------------------------------------------------
    // ADMIN CHECK
    // --------------------------------------------------------

    fn require_admin(
        env: &Env,
    ) -> Address {

        let admin: Address = env
            .storage()
            .instance()
            .get(&DataKey::Admin)
            .unwrap_or_else(|| {
                panic!("Contract not initialized")
            });

        admin.require_auth();

        admin
    }

    // --------------------------------------------------------
    // RESET CLAIM
    // --------------------------------------------------------

    pub fn reset_claim(
        env: Env,
        user: Address,
    ) {
        let admin = Self::require_admin(&env);

        let claimed: bool = env
            .storage()
            .persistent()
            .get(&DataKey::Claimed(user.clone()))
            .unwrap_or(false);

        if !claimed {
            panic!("Reward has not been claimed");
        }

        env.storage()
            .persistent()
            .set(
                &DataKey::Claimed(user.clone()),
                &false,
            );

        env.events().publish(
            (
                symbol_short!("admin"),
                symbol_short!("reset"),
            ),
            (
                admin,
                user,
            ),
        );
    }

    // --------------------------------------------------------
    // ADMIN REVOKE REWARD
    // --------------------------------------------------------

    pub fn revoke_reward(
        env: Env,
        user: Address,
    ) {
        let admin = Self::require_admin(&env);

        let reward: i128 = env
            .storage()
            .persistent()
            .get(&DataKey::Reward(user.clone()))
            .unwrap_or(0);

        if reward <= 0 {
            panic!("No reward available");
        }

        env.storage()
            .persistent()
            .set(
                &DataKey::Reward(user.clone()),
                &0i128,
            );

        let total: i128 = env
            .storage()
            .instance()
            .get(&DataKey::TotalRewards)
            .unwrap_or(0);

        let remaining = total
            .checked_sub(reward)
            .unwrap_or(0);

        env.storage()
            .instance()
            .set(
                &DataKey::TotalRewards,
                &remaining,
            );

        // ----------------------------------------------------
        // REVOKE EVENT
        // ----------------------------------------------------

        env.events().publish(
            (
                symbol_short!("admin"),
                symbol_short!("revoke"),
            ),
            (
                admin,
                user,
                reward,
            ),
        );
    }

    // --------------------------------------------------------
    // ADMIN UPDATE REWARD
    // --------------------------------------------------------

    pub fn update_reward(
        env: Env,
        user: Address,
        amount: i128,
    ) {
        let admin = Self::require_admin(&env);

        if amount < 0 {
            panic!("Reward cannot be negative");
        }

        let old_reward: i128 = env
            .storage()
            .persistent()
            .get(&DataKey::Reward(user.clone()))
            .unwrap_or(0);

        env.storage()
            .persistent()
            .set(
                &DataKey::Reward(user.clone()),
                &amount,
            );

        let total: i128 = env
            .storage()
            .instance()
            .get(&DataKey::TotalRewards)
            .unwrap_or(0);

        let adjusted_total = total
            .checked_sub(old_reward)
            .and_then(|value| value.checked_add(amount))
            .unwrap_or_else(|| {
                panic!("Reward accounting overflow")
            });

        env.storage()
            .instance()
            .set(
                &DataKey::TotalRewards,
                &adjusted_total,
            );

        env.events().publish(
            (
                symbol_short!("admin"),
                symbol_short!("update"),
            ),
            (
                admin,
                user,
                old_reward,
                amount,
            ),
        );
    }
}

// ============================================================
// TRANSACTION FLOW
// ============================================================

/*

Correct reward claim flow:

    User
      |
      v
claim_reward()
      |
      v
require_auth()
      |
      v
Check already claimed
      |
      +---- YES ---> Reject transaction
      |
      v
Load reward
      |
      +---- ZERO ---> Reject transaction
      |
      v
before_claim()
      |
      v
Mark claimed
      |
      v
Clear reward
      |
      v
Update accounting
      |
      v
Create claim record
      |
      v
after_claim()
      |
      v
Emit claim event
      |
      v
Return reward


IMPORTANT:

Soroban transactions are atomic. If any operation in the
transaction fails, the transaction is rolled back.

This means that the claim should not be marked as successful
until the necessary validation and accounting operations have
succeeded.
*/

// ============================================================
// EXAMPLE EVENTS
// ============================================================

/*

Before claim:

topic:
    ("hook", "before")

data:
    (user, amount)


Successful claim:

topic:
    ("reward", "claim")

data:
    (
        user,
        amount,
        claim_id,
        timestamp
    )


After claim:

topic:
    ("hook", "after")

data:
    (
        user,
        amount,
        claim_id
    )


Admin reward creation:

topic:
    ("reward", "create")

data:
    (
        admin,
        user,
        amount
    )
*/

